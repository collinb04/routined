# Auth0 SPA app — see docs/SETUP.md for how to configure the Auth0 tenant.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# Backend origin for /api and /auth requests. Leave empty for local dev — the
# Vite proxy (vite.config.ts) makes those paths same-origin. Set to the
# backend's deployed URL in prod (e.g. https://routined-backend-xxxxx.a.run.app).
VITE_API_URL=
