# Postgres connection string.
# Local dev — see docker-compose.yml for credentials:
#   postgresql://user:password@localhost:5432/routined_db
# Cloud Run + Cloud SQL — attach the instance with
# `gcloud run deploy --add-cloudsql-instances=PROJECT:REGION:INSTANCE`, which
# mounts a unix socket at /cloudsql/<connection-name>, then:
#   postgresql://user:password@/routined_db?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://user:password@localhost:5432/routined_db

# Flask session-signing key. Generate with: openssl rand -hex 32
FLASK_SECRET_KEY=

# Auth0 tenant app (Regular Web App, "Username-Password-Authentication" connection
# enabled) — see docs/SETUP.md for configuration steps.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Anthropic API key — powers the Socratic tutor and insight grading.
ANTHROPIC_API_KEY=

# Resend API key — welcome emails, bug reports, contact form.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=onboarding@resend.dev
CONTACT_EMAIL_TO=

# Set to this backend's deployed https URL in production — enables the
# Secure session cookie flag and SameSite=None (needed since the frontend is
# a separate origin). Leave unset for local http development.
APP_BASE_URL=

# Comma-separated frontend origin(s) allowed to call this API with
# credentials, e.g. https://routined-frontend-xxxxx.a.run.app . Required in
# prod; leave empty for local dev (Vite proxy makes it same-origin there).
CORS_ORIGINS=
