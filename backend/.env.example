# Postgres connection string — see docker-compose.yml for local dev credentials.
DATABASE_URL=postgresql://user:password@localhost:5432/routined_db

# Flask session-signing key. Generate with: openssl rand -hex 32
FLASK_SECRET_KEY=

# Auth0 tenant app (Regular Web App, "Username-Password-Authentication" connection
# enabled) — see docs/SETUP.md for configuration steps.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Anthropic API key — powers the Socratic tutor and insight grading.
ANTHROPIC_API_KEY=

# Resend API key — welcome emails, bug reports, contact form.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=onboarding@resend.dev
CONTACT_EMAIL_TO=

# Set to your deployed https URL in production — enables the Secure session
# cookie flag. Leave unset for local http development.
APP_BASE_URL=
